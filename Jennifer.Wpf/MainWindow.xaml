<Window x:Class="Jennifer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jennifer"
        Width="1600"
        Height="1200"
        MinWidth="1100"
        MinHeight="980"
        Background="#0F172A"
        Foreground="#E5E7EB">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111827" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="AccentBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#134E4A" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#334155" />
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E5E7EB" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- ── Tab styles ───────────────────────────────────── -->
        <Style x:Key="JTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="JTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrushColor}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,3,0"
                                Padding="14,7"
                                Cursor="Hand">
                            <ContentPresenter x:Name="HeaderText"
                                              ContentSource="Header"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.FontSize="13"
                                              TextBlock.Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="HeaderText" Property="TextBlock.Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderText" Property="TextBlock.Foreground" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource SurfaceBrush}"
              Foreground="#E5E7EB"
              BorderBrush="{StaticResource BorderBrushColor}"
              BorderThickness="0,0,0,1">
            <Menu.Resources>
                <!-- Shared menu-panel styles so forms inside menu items look consistent -->
                <Style x:Key="MenuPanelTextBox" TargetType="TextBox">
                    <Setter Property="Background" Value="#0B1220" />
                    <Setter Property="Foreground" Value="#E5E7EB" />
                    <Setter Property="BorderBrush" Value="#334155" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="Margin" Value="0,3,0,0" />
                </Style>
                <Style x:Key="MenuPanelLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E2E8F0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                </Style>
                <Style x:Key="MenuPanelHint" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="0,3,0,0" />
                </Style>
                <Style x:Key="MenuPanelButton" TargetType="Button">
                    <Setter Property="Background" Value="#14B8A6" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#14B8A6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
            </Menu.Resources>

            <!-- ── File ─────────────────────────────────────── -->
            <MenuItem Header="_File" Foreground="#E5E7EB">
                <MenuItem Header="Load _Automation Plan…" Click="LoadAutomationPlanButton_Click" />
                <Separator />
                <MenuItem Header="_Save Settings" Click="SaveSettingsMenuItem_Click" />
                <MenuItem Header="Open Settings _File" Click="OpenSettingsFileMenuItem_Click"
                          ToolTip="Opens the settings JSON in the default text editor." />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>

            <!-- ── Connection ────────────────────────────────── -->
            <MenuItem Header="_Connection" Foreground="#E5E7EB">
                <MenuItem IsEnabled="False">
                    <MenuItem.Header>
                        <StackPanel Width="240" Margin="4,6,4,10">
                            <TextBlock Style="{StaticResource MenuPanelHint}"
                                       Text="Configure endpoint and game name in the Settings tab." />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0"
                Padding="16,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Jennifer" FontFamily="Bahnschrift" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="Neuro action console — registration · forced actions · automation replies" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,8"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Status" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Starting…" />
                            <TextBlock Width="14" />
                            <TextBlock x:Name="ClientsText" FontWeight="SemiBold" Text="Clients: 0" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Notifications overlay -->
        <StackPanel x:Name="NotificationsPanel"
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,56,0,0"
                    Orientation="Vertical"
                    IsHitTestVisible="False" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Left panel — tabbed -->
            <TabControl Grid.Column="0"
                        Style="{StaticResource JTabControl}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1">

                <!-- ── Tab 1: Actions ──────────────────────────────── -->
                <TabItem Header="Actions" Style="{StaticResource JTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>

                            <!-- Quick Action buttons (game-registered, above catalog) -->
                            <TextBlock Style="{StaticResource LabelStyle}" Margin="0,4,0,0" Text="Quick Actions" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="Game-registered actions — click to dispatch immediately." />
                            <ScrollViewer MinHeight="48"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,4,0,0">
                                <WrapPanel x:Name="ActionButtonsPanel" />
                            </ScrollViewer>

                            <!-- Action catalog list -->
                            <TextBlock Style="{StaticResource LabelStyle}" Margin="0,12,0,0" Text="Action Catalog" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="All known actions — game, source, and manually added. [G] = game · [S] = source." />
                            <ListBox x:Name="ActionCatalogList"
                                     MinHeight="120"
                                     SelectionMode="Extended"
                                     SelectionChanged="ActionsList_SelectionChanged" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AddActionButton" Width="80" Content="Add" Click="AddActionButton_Click" />
                                <Button x:Name="RemoveActionButton" Width="80" Content="Remove" Click="RemoveActionButton_Click" />
                                <Button x:Name="SendActionButton" Width="100" Content="Send Selected" Click="SendActionButton_Click" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Custom Action Name" />
                            <TextBox x:Name="CustomActionNameBox" />

                            <!-- Parameter Form (appears when a schema action is selected) -->
                            <Border x:Name="ParamFormBorder"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock x:Name="ParamFormTitle"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0,0,0,4"
                                               Text="Parameters" />
                                    <StackPanel x:Name="ParamFieldsPanel" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DispatchWithParamsButton"
                                                Grid.Column="0"
                                                Content="Dispatch with Params"
                                                Click="DispatchWithParamsButton_Click" />
                                        <Button x:Name="DispatchNoParamsButton"
                                                Grid.Column="2"
                                                Margin="0"
                                                Content="Dispatch (no params)"
                                                Click="DispatchNoParamsButton_Click" />
                                        <Button x:Name="CopyParamJsonButton"
                                                Grid.Column="4"
                                                Margin="0"
                                                Content="Copy as JSON"
                                                Click="CopyParamJsonButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 2: Force ────────────────────────────────── -->
                <TabItem Header="Force" Style="{StaticResource JTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>

                            <TextBlock Style="{StaticResource LabelStyle}" Margin="0,4,0,0" Text="State" />
                            <TextBox x:Name="StateTextBox"
                                     Height="70"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Query" />
                            <TextBox x:Name="QueryTextBox"
                                     Height="70"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Priority" />
                                <ComboBox x:Name="PriorityCombo" Grid.Column="1" Margin="10,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="low" />
                                    <ComboBoxItem Content="medium" />
                                    <ComboBoxItem Content="high" />
                                    <ComboBoxItem Content="critical" />
                                </ComboBox>
                                <CheckBox x:Name="EphemeralCheck" Grid.Column="2" Margin="14,0,0,0" IsChecked="True" Content="Ephemeral" />
                            </Grid>

                            <Button x:Name="ForceActionsButton"
                                    Margin="0,10,0,0"
                                    Width="120"
                                    Content="Force Actions"
                                    Click="ForceActionsButton_Click" />

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 3: Automation ───────────────────────────── -->
                <TabItem Header="Automation" Style="{StaticResource JTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>

                            <TextBlock x:Name="AutomationPlanText"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"
                                       Text="No automation plan loaded" />
                            <TextBlock x:Name="AutomationDescriptionText"
                                       Style="{StaticResource HintStyle}"
                                       Text="Load a Jennifer automation file to prefill actions and auto-reply to incoming actions." />

                            <CheckBox x:Name="AutomationAutoReplyCheck"
                                      Margin="0,10,0,0"
                                      Content="Auto-send results for matching loaded steps" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="LoadAutomationPlanButton" Width="100" Content="Load Plan"     Click="LoadAutomationPlanButton_Click" />
                                <Button x:Name="RunSelectedAutomationButton" Width="110" Content="Run Selected" Click="RunSelectedAutomationButton_Click" />
                                <Button x:Name="RunAllAutomationButton" Width="80" Content="Run All"       Click="RunAllAutomationButton_Click" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Loaded Steps" />
                            <ListBox x:Name="AutomationStepsList"
                                     MinHeight="120"
                                     DisplayMemberPath="DisplayName"
                                     SelectionMode="Extended" />

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Tab 4: Settings ────────────────────────────── -->
                <TabItem Header="Settings" Style="{StaticResource JTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>

                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" Text="Action Source" />
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Directory containing Neuro action source files (.cs). Leave blank to auto-discover a sibling NeuroMod folder. Point this at any mod's Actions folder to use Jennifer with other projects." />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ActionSourceDirectoryText"
                                         Grid.Column="0"
                                         ToolTip="Full path to the Actions directory (e.g. C:\MyMod\Actions). Empty = auto-discover." />
                                <Button x:Name="BrowseSourceDirButton"
                                        Grid.Column="2"
                                        Content="Browse…"
                                        Width="72"
                                        Click="BrowseSourceDirButton_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="ReloadSourceActionsButton"
                                        Width="140"
                                        Content="Reload Source Actions"
                                        ToolTip="Re-scan the configured source directory and refresh the action catalog."
                                        Click="ReloadSourceActionsButton_Click" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,0" Text="Connection" />

                            <TextBlock Style="{StaticResource LabelStyle}" Margin="0,0,0,0" Text="Endpoint" />
                            <TextBox x:Name="EndpointText"
                                     Text="ws://localhost:8000"
                                     ToolTip="WebSocket URL of the Neuro server (Randy or a mod's built-in server)." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Game Name (optional)" />
                            <TextBox x:Name="GameNameText"
                                     Text=""
                                     ToolTip="Auto-filled when the game announces its name via actions/register. Leave blank to omit the game field." />
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Blank = generic Neuro mod connection (game field omitted from all payloads)." />

                            <CheckBox x:Name="AutoConnectCheck"
                                      Margin="0,10,0,0"
                                      IsChecked="True"
                                      Content="Auto-connect on startup"
                                      ToolTip="When checked Jennifer will try to connect to the endpoint automatically when launched." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="TCP Listener Port" />
                            <TextBox x:Name="TcpListenerPortText"
                                     Text="8081"
                                     ToolTip="Local port for the legacy TCP compatibility listener. Restart required to change." />
                            <TextBlock Style="{StaticResource HintStyle}" Text="Takes effect on next launch." />

                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,0" Text="Built-in WebSocket Broker" />
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Brokers messages between Jennifer and the game. Port changes take effect on next launch." />

                            <CheckBox x:Name="TestServerEnabledCheck"
                                      Margin="0,10,0,0"
                                      IsChecked="True"
                                      Content="Enable TestServer on startup"
                                      ToolTip="Disable if you connect to a real Randy instance instead." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="WebSocket Port" />
                            <TextBox x:Name="TestServerWsPortText"
                                     Text="8000"
                                     ToolTip="Port the TestServer WebSocket broker listens on (default: 8000)." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="HTTP Helper Port" />
                            <TextBox x:Name="TestServerHttpPortText"
                                     Text="1337"
                                     ToolTip="Port for the TestServer HTTP helper (NEURO_SDK_WS_URL env query, default: 1337)." />

                            <TextBlock Style="{StaticResource HintStyle}" Margin="0,8,0,0"
                                       Text="Save Settings then restart Jennifer to apply port changes." />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="ConnectButton"
                                        Width="100"
                                        Content="Connect"
                                        Click="ConnectButton_Click" />
                                <Button x:Name="RegisterActionsButton"
                                        Width="140"
                                        Content="Register Actions"
                                        Click="RegisterActionsButton_Click" />
                                <Button Width="120"
                                        Content="Save Settings"
                                        Click="SaveSettingsMenuItem_Click" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- Right panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" MinHeight="240" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Activity Log" />

                        <TextBox x:Name="ResponseLog"
                                 Grid.Row="1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="2*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- Incoming Actions -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Incoming Actions" />
                            <ListBox x:Name="IncomingActionsList"
                                     Height="200"
                                     DisplayMemberPath="DisplayName"
                                     SelectionChanged="IncomingActionsList_SelectionChanged" />
                        </StackPanel>

                        <!-- Result Items (extracted from last result — drag or click to fill data) -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Result Items" />
                            <TextBlock Style="{StaticResource HintStyle}"
                                       Text="Click or drag an item to fill a parameter field →"
                                       Margin="0,0,0,6" />
                            <ListBox x:Name="ResultItemsList"
                                     Height="180"
                                     SelectionChanged="ResultItemsList_SelectionChanged"
                                     PreviewMouseLeftButtonDown="ResultItemsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ResultItemsList_PreviewMouseMove" />
                        </StackPanel>

                        <!-- Action Result + dispatch data -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Action Result" />
                            <TextBox x:Name="IncomingActionPayloadBox"
                                     Height="80"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Data (JSON)" Margin="0,8,0,0" />
                            <TextBox x:Name="ActionDataJsonBox"
                                     Height="52"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     AllowDrop="True"
                                     DragOver="ActionDataJsonBox_DragOver"
                                     Drop="ActionDataJsonBox_Drop"
                                     ToolTip="JSON data for the next dispatch. Drop a Result Item here or click one to fill automatically." />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="ResultSuccessCheck" IsChecked="True" Content="Success" VerticalAlignment="Center" />
                                <TextBox x:Name="ResultMessageText"
                                         Margin="10,0,0,0"
                                         Width="140"
                                         VerticalAlignment="Center"
                                         ToolTip="Result message to send back" />
                                <Button x:Name="SendActionResultButton"
                                        Margin="8,0,0,0"
                                        Width="90"
                                        Content="Send Result"
                                        Click="SendActionResultButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
